		"check": "node scripts/compile-messages.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@opentoys/core": "*",
		"@opentoys/devices": "*",
		"@opentoys/web-ble": "*",
