{
	"name": "@opentoys/web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"description": "The opentoys web app (static SvelteKit PWA)",
	"license": "PolyForm-Noncommercial-1.0.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
